# Production environment variables for Dokploy deployment.
# Set these as environment variables in Dokploy's application settings.
# NEVER commit actual credentials to version control.

# ── SilverStripe Database ──────────────────────────────────────────────────────
# For Dokploy: create a MySQL service and use its internal hostname here.
# The internal host is typically the service name, e.g. "my-mysql" or
# a Dokploy-generated hostname like "mysql-xxxx".
SS_DATABASE_CLASS=MySQLDatabase
SS_DATABASE_SERVER=<dokploy-mysql-hostname>
SS_DATABASE_PORT=3306
SS_DATABASE_USERNAME=silverstripe
SS_DATABASE_PASSWORD=change_this_strong_password
SS_DATABASE_NAME=silverstripe
SS_ENVIRONMENT_TYPE=live

# ── SilverStripe Admin ─────────────────────────────────────────────────────────
# Default admin account created on first dev/build. Remove after creating
# a real admin user through the CMS.
SS_DEFAULT_ADMIN_USERNAME=admin
SS_DEFAULT_ADMIN_PASSWORD=change_this_admin_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# Example: https://lustrum.example.com,https://www.lustrum.example.com
CORS_ALLOWED_ORIGINS=

# ── Optional ──────────────────────────────────────────────────────────────────
# SS_BASE_URL=https://api.lustrum.example.com
