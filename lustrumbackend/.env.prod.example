# Production environment variables for Docker Compose.
# Copy this file to .env and fill in real credentials before deploying.
# NEVER commit .env to version control.

# ── SilverStripe ───────────────────────────────────────────────────────────────
SS_DATABASE_CLASS=MySQLDatabase
SS_DATABASE_SERVER=db
SS_DATABASE_USERNAME=silverstripe
SS_DATABASE_PASSWORD=change_this_strong_password
SS_DATABASE_NAME=silverstripe
SS_ENVIRONMENT_TYPE=live

SS_DEFAULT_ADMIN_USERNAME=admin
SS_DEFAULT_ADMIN_PASSWORD=change_this_admin_password

# ── MySQL container ────────────────────────────────────────────────────────────
# SS_DATABASE_ROOT_PASSWORD is only used by the db service in docker-compose.prod.yml.
# It is not read by SilverStripe itself.
SS_DATABASE_ROOT_PASSWORD=change_this_root_password

# ── Docker Compose ─────────────────────────────────────────────────────────────
# APP_PORT=80
